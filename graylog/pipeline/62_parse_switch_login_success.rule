rule "switch: parse admin login success"
when
  contains(to_string($message.message), "%SEC_LOGIN-5-LOGIN_SUCCESS:")
then
  //   %SEC_LOGIN-5-LOGIN_SUCCESS: Login Success [user: admin] [Source: 192.168.99.10] [localport: 22] at 10:15:32 ICT Fri Oct 23 2026
  let m = regex("\\[user: ([^\\]]*)\\] \\[Source: ([0-9a-fA-F.:]+)\\] \\[localport: ([0-9]+)\\]",
                to_string($message.message), ["user", "src_ip", "dst_port"]);
  set_field("event_source", "switch");
  set_field("event_category", "switch");
  set_field("event_type", "device_login_success");
  set_field("event_outcome", "success");
  set_field("net_device", $message.source);
  set_field("user", m["user"]);
  set_field("src_ip", m["src_ip"]);
  set_field("dst_port", to_long(m["dst_port"]));
end
