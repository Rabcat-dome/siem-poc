rule "wifi: parse AP admin login failure (dropbear)"
when
  regex("dropbear\\[[0-9]+\\]: Bad password attempt for '[^']*' from ", to_string($message.message)).matches == true
then
  //   ap-office01 dropbear[1234]: Bad password attempt for 'admin' from 192.168.10.23:51234
  let m = regex("Bad password attempt for '([^']*)' from ([0-9a-fA-F.:]+?):([0-9]+)$", to_string($message.message),
                ["user", "src_ip", "src_port"]);
  set_field("event_source", "wifi-ap");
  set_field("event_category", "wifi");
  set_field("event_type", "device_login_failure");
  set_field("event_outcome", "failure");
  set_field("net_device", $message.source);
  set_field("user", m["user"]);
  set_field("src_ip", m["src_ip"]);
  set_field("src_port", to_long(m["src_port"]));
end
