rule "opnsense: parse Unbound DNS query"
when
  to_string($message.application_name) == "unbound" &&
  regex("info: [0-9a-fA-F.:]+ \\S+ \\S+ IN", to_string($message.message)).matches == true
then
  // log-queries: <client> <qname> <qtype> <qclass>; blocked answers are a different line (19b)
  let m = regex("info: ([0-9a-fA-F.:]+) (\\S+?)\\.? (\\S+) IN", to_string($message.message), ["src_ip", "dns_query", "dns_qtype"]);
  set_field("event_source", "opnsense");
  set_field("event_category", "dns");
  set_field("event_type", "dns_query");
  set_field("src_ip", m["src_ip"]);
  set_field("dns_query", lowercase(to_string(m["dns_query"])));
  set_field("dns_qtype", m["dns_qtype"]);
  // parent domain (www.facebook.com -> facebook.com) so category lists match subdomains
  let p = regex("^[^.]+\\.(.+\\..+)$", lowercase(to_string(m["dns_query"])), ["parent"]);
  set_field("dns_parent", p["parent"]);
end
