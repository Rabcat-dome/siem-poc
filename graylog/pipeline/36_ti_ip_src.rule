rule "threat intel: source IP is an IOC"
when
  has_field("src_ip") &&
  is_not_null(lookup_value("threat-intel-ip", to_string($message.src_ip)))
then
  set_field("threat_indicator", true);
  set_field("threat_ioc", $message.src_ip);
  set_field("threat_category", lookup_value("threat-intel-ip", to_string($message.src_ip)));
end
