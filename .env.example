# Copy to .env and change before using anywhere beyond a laptop POC.
# Graylog: at least 16 chars, e.g.  openssl rand -hex 32
GRAYLOG_PASSWORD_SECRET=change-me-0123456789abcdef0123456789abcdef
# SHA-256 of the admin password, e.g.  printf 'NewPassw0rd' | shasum -a 256 | cut -d' ' -f1
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
# Plain admin password, used only by the provisioner to call the Graylog API (must match the hash above)
GRAYLOG_ADMIN_PASSWORD=admin

# Retention (Q2): days of searchable logs, days of alert history
LOG_RETENTION_DAYS=90
EVENT_RETENTION_DAYS=365

# RBAC users (Q16) - left empty, the provisioner skips them
#   it-analyst: IT team, can search and edit rules/alerts, cannot delete logs or change retention
#   log-admin : break-glass admin, password held by management / ISMS manager
IT_ANALYST_PASSWORD=
LOG_ADMIN_PASSWORD=

# Account the RPT-01 report uses to read Graylog (use it-analyst once it exists)
REPORT_USER=admin
REPORT_PASSWORD=admin

# Log simulator
INTERVAL_SECONDS=5
SCENARIO_RATE=0.25

# --- Production exposure (defaults are the POC values) ---
# Host ports for syslog UDP+TCP; the container always listens on 1514 (runs non-root).
# Production: 514 so OPNsense can use the standard port.
SYSLOG_HOST_PORT=1514
# Syslog over TLS (NFR-05). Needs ./tls/server.crt + server.key from tools/gen_tls_certs.sh
SYSLOG_TLS_HOST_PORT=6514
# Web UI / API bind as ip:port. Production: the Management VLAN address, e.g. 10.10.10.5:9000. Never 0.0.0.0.
GRAYLOG_UI_BIND=127.0.0.1:9000

# =====================================================================================
# Production (docker-compose.prod.yml + deploy/). Check with:
#   python3 tools/preflight_check.py --env .env --tls-dir tls --prod
# =====================================================================================
# SIEM host in the Management VLAN; the cert from tools/gen_tls_certs.sh must carry both names
SIEM_FQDN=siem.example.local
SIEM_HOST_IP=
# Docker network for the stack; must not overlap any office VLAN
DOCKER_SUBNET=172.30.10.0/24
GRAYLOG_HEAP=1g
OPENSEARCH_HEAP=2g

# Host firewall (deploy/firewall/siem-docker-user.sh): office-facing NIC, syslog source, UI sources
SIEM_EXT_IF=
OPNSENSE_SYSLOG_IP=192.168.99.1
SIEM_ADMIN_NETS=192.168.99.0/24

# Alert e-mail through the company relay (Q4: e-mail only, so WEBHOOK_URL stays empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_AUTH=true
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=siem@example.local
ALERT_EMAIL_TO=it-team@example.local
WEBHOOK_URL=

# OPNsense API (read-only key): asset sync, web categories, config.xml backup
OPNSENSE_URL=https://192.168.99.1
OPNSENSE_KEY=
OPNSENSE_SECRET=
OPNSENSE_INSECURE=true
# kea | dnsmasq | config-xml (ISC dhcpd has no API)
OPNSENSE_DHCP_BACKEND=kea

# Scheduled jobs (deploy/siem-job.sh)
ARCHIVE_DIR=/mnt/log-archive
MANIFEST_DIR=/mnt/log-manifest
REPORT_DIR=/opt/siem/reports
REPORT_EMAIL_TO=management@example.local

# Backups (deploy/backup.sh): the Synology share, days to keep, passphrase for the config tarball
BACKUP_DIR=/mnt/siem-backup
BACKUP_KEEP_DAYS=30
BACKUP_PASSPHRASE=
