# Copy to .env and change before using anywhere beyond a laptop POC.
# Graylog: at least 16 chars, e.g.  openssl rand -hex 32
GRAYLOG_PASSWORD_SECRET=change-me-0123456789abcdef0123456789abcdef
# SHA-256 of the admin password, e.g.  printf 'NewPassw0rd' | shasum -a 256 | cut -d' ' -f1
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
# Plain admin password, used only by the provisioner to call the Graylog API (must match the hash above)
GRAYLOG_ADMIN_PASSWORD=admin

# Log simulator
INTERVAL_SECONDS=5
SCENARIO_RATE=0.25
